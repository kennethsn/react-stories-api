{
  "name": "react-stories-api",
  "version": "1.0.0-dev-49",
  "author": "Kenneth Seals-Nutt",
  "babel": {
    "presets": [
      "@babel/preset-env",
      [
        "@babel/preset-react",
        {
          "runtime": "automatic"
        }
      ],
      "@babel/preset-typescript"
    ],
    "sourceType": "unambiguous"
  },
  "bugs": {
    "url": "https://github.com/kennethsn/react-stories-api/issues"
  },
  "config": {
    "commitizen": {
      "path": "@commitlint/cz-commitlint"
    }
  },
  "description": "React Components for building interactive data storytelling interfaces with the Stories API",
  "dependencies": {
    "@fontsource/roboto": "^5.2.6",
    "@mui/stylis-plugin-rtl": "^7.3.3",
    "deck.gl": "^9.1.14",
    "lodash.debounce": "^4.0.8",
    "maplibre-gl": "^5.7.1",
    "react-countup": "^6.5.3",
    "react-if": "^4.1.6",
    "react-map-gl": "^8.0.4",
    "react-markdown": "^10.1.0",
    "react-multi-carousel": "^2.8.6",
    "react-photo-view": "^1.2.7",
    "react-player": "^2.16.1",
    "react-resizable-panels": "^3.0.6",
    "react-use-error-boundary": "^3.0.0",
    "stylis": "^4.3.6",
    "stylis-plugin-rtl": "^2.1.1",
    "swiper": "^11.2.10"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.28.0",
    "@babel/preset-react": "^7.27.1",
    "@babel/preset-typescript": "^7.27.1",
    "@chromatic-com/storybook": "^4.1.0",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@commitlint/cz-commitlint": "^19.8.1",
    "@commitlint/prompt-cli": "^19.8.1",
    "@rollup/plugin-commonjs": "^28.0.6",
    "@rollup/plugin-dynamic-import-vars": "^2.1.5",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-typescript": "^11.1.6",
    "@storybook/addon-docs": "^9.1.2",
    "@storybook/addon-links": "^9.1.2",
    "@storybook/addon-onboarding": "^9.1.2",
    "@storybook/react-vite": "^9.1.2",
    "@testing-library/jest-dom": "^6.7.0",
    "@testing-library/react": "^16.3.0",
    "@types/jest": "^29.5.14",
    "@types/lodash.debounce": "^4.0.9",
    "@types/react": "^18.3.23",
    "@types/rollup-plugin-peer-deps-external": "^2.2.5",
    "@types/stylis": "^4.2.7",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "commitizen": "^4.3.1",
    "eslint": "^8.57.1",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-airbnb-typescript": "^18.0.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.20",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-storybook": "^9.1.2",
    "husky": "^9.1.7",
    "inquirer": "^9.3.7",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "relative-deps": "^1.0.7",
    "rollup": "^4.46.2",
    "rollup-plugin-dts": "^6.2.1",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "rollup-plugin-postcss": "^4.0.2",
    "standard-version": "^9.5.0",
    "storybook": "^9.1.2",
    "storybook-addon-deep-controls": "^0.9.5",
    "tslib": "^2.8.1",
    "typescript": "^5.9.2"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./types": "./dist/esm/types/types.d.ts"
  },
  "files": [
    "dist"
  ],
  "homepage": "https://github.com/kennethsn/react-stories-api#readme",
  "jest": {
    "testEnvironment": "jsdom",
    "transformIgnorePatterns": [
      "node_modules/(?!swiper)/"
    ]
  },
  "license": "MIT",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "overrides": {
    "storybook": "$storybook"
  },
  "peerDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^6.4.8",
    "@mui/lab": "^6.0.1-beta.36",
    "@mui/material": "^6.5.0",
    "html-react-parser": "^5.2.6",
    "mobx": "^6.13.7",
    "mobx-react-lite": "^4.1.0",
    "react": ">=18",
    "react-router-dom": "^7.8.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kennethsn/react-stories-api.git"
  },
  "scripts": {
    "build": "rollup  -c",
    "build-storybook": "storybook build",
    "clean": "rm -rf dist",
    "commit": "git-cz",
    "dev": "rollup -c -w",
    "lint": "eslint . --ext cjs,js,jsx,mjs,ts,tsx",
    "lint:fix": "npm run lint -- --fix",
    "prepare": "husky",
    "storybook": "storybook dev -p 6006",
    "storybook:upgrade": "npx storybook@next upgrade",
    "release": "standard-version",
    "test": "jest",
    "test:watch": "npm test -- --watchAll --verbose"
  },
  "types": "dist/index.d.ts",
  "typings": "dist/index.d.ts"
}